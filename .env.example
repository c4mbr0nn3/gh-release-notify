# Optional GitHub token for higher API rate limits (5000 req/hour vs 60).
# Create one at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Overrides [smtp].password in config.toml. Keeps the secret out of the config file.
SMTP_PASSWORD=

# Admin token for the web UI login. Alternative: set [ui].admin_token in
# config.toml. If BOTH this and admin_token are unset, the UI runs with no
# login (open mode) — only safe on a trusted network. Setting this together
# with trust_proxy_auth = true is a startup error.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
